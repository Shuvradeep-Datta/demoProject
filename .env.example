# ─────────────────────────────────────────────────────────────
# Shuvradeep Datta — Portfolio environment configuration example
# Copy this file to `.env` and fill in the values you want to use.
# All values are optional; the app ships with safe placeholders.
# ─────────────────────────────────────────────────────────────

# Base path for the built site.
# - Root/user site:        "/"
# - GitHub Pages project:   "/<your-repo-name>/"
# The GitHub Actions workflow sets this automatically from the repo name.
VITE_BASE=/

# Contact form submission endpoint.
# Point this at a form backend such as Formspree, Getform, Basin, or your
# own API. Example (Formspree): https://formspree.io/f/your-form-id
# If left empty, the contact form falls back to opening the user's mail client.
VITE_CONTACT_ENDPOINT=

# Public resume file path (served from /public). Default: /resume.pdf
VITE_RESUME_PATH=/resume.pdf
